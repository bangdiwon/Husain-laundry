{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.6.1"
    }
  },
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ]
}
